{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "regions": ["iad1"],
  "env": {
    "QUOTES_REPOSITORY_DRIVER": "postgres",
    "RATE_LIMIT_STORE_DRIVER": "memory",
    "LOG_LEVEL": "info",
    "TRUSTED_PROXY_COUNT": "2",
    "NEXT_PUBLIC_QUOTES_API_ENABLED": "true",
    "NODE_ENV": "production",
    "QUOTES_NOTIFICATION_EMAIL": "hola@camiprint.com",
    "RESEND_FROM_EMAIL": "noreply@camiart.com",
    "RESEND_FROM_NAME": "Camiprint"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true
    }
  },
  "github": {
    "silent": false,
    "autoJobCancelation": true
  },
  "crons": [
    {
      "path": "/api/cron/products-image-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/quotes-sla-breach",
      "schedule": "0 4 * * *"
    }
  ]
}

