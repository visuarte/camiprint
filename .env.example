# Persistencia de cotizaciones
QUOTES_REPOSITORY_DRIVER=json

# Requerido cuando QUOTES_REPOSITORY_DRIVER=postgres
DATABASE_URL=postgres://camiart:camiart@127.0.0.1:5432/camiart

# Rate limiting distribuido
# Valores: memory (default, single-replica) | redis (multi-replica)
RATE_LIMIT_STORE_DRIVER=memory

# Requerido cuando RATE_LIMIT_STORE_DRIVER=redis
REDIS_URL=redis://127.0.0.1:6379

# Observabilidad
# Token Bearer para GET /api/v1/metrics. Sin valor = endpoint abierto (solo dev)
METRICS_TOKEN=

# Nivel de log para pino: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info

# Feature flag: habilita el submit real al API de cotizaciones
# false = simula exito sin llamar al backend (util para desarrollo sin backend)
# true  = llama a /api/v1/quotes (default cuando no esta definida)
NEXT_PUBLIC_QUOTES_API_ENABLED=true

# Seguridad de IP
# Número de proxies de confianza delante de la app (default: 1 para Vercel/nginx)
TRUSTED_PROXY_COUNT=1

# CORS: origenes permitidos para el endpoint /api/v1/quotes (separados por coma)
# Desarrollo: http://localhost:3000,http://localhost:3001
# Produccion: https://camiprint.com,https://www.camiprint.com
ALLOWED_ORIGINS=http://localhost:3000

# Stripe Integration (DAY 2)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Admin Auth Token for /api/orders/admin routes (MVP simple auth)
# IMPORTANT: Change this in production
ADMIN_AUTH_TOKEN=admin_token_12345_change_in_production
