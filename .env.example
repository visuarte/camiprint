# Persistencia de cotizaciones
QUOTES_REPOSITORY_DRIVER=json

# Requerido cuando QUOTES_REPOSITORY_DRIVER=postgres
DATABASE_URL=postgres://camiart:camiart@127.0.0.1:5432/camiart

# Rate limiting distribuido
# Valores: memory (default, single-replica) | redis (multi-replica)
RATE_LIMIT_STORE_DRIVER=memory

# Requerido cuando RATE_LIMIT_STORE_DRIVER=redis
REDIS_URL=redis://127.0.0.1:6379
